{
  "schema_version": "bigan-v8-persistent-outcome-blind-collector-protocol-v1",
  "protocol_name": "persistent_outcome_blind_btc_updown_5m_raw_collection_v1",
  "frozen": true,
  "market_family": "btc_updown_5m",
  "default_batch_round_count": 12,
  "collection_mode": "raw_pending_capture_only",
  "outcome_blind_collection_only": true,
  "settlement_finalizer_enabled": false,
  "resolution_provider_enabled": false,
  "training_corpus_export_enabled": false,
  "labels_outcomes_or_pnl_opened": false,
  "required_raw_artifacts": [
    "raw_polymarket_markets.jsonl",
    "raw_polymarket_orderbooks.jsonl",
    "raw_polymarket_trades.jsonl",
    "raw_binance_btcusdt_klines.jsonl",
    "raw_polymarket_chainlink_prices.jsonl"
  ],
  "resolution_artifact": "raw_polymarket_resolutions.jsonl",
  "resolution_artifact_required_row_count": 0,
  "quality_validity_inputs": [
    "raw_evidence_completeness",
    "capture_boundary_causality",
    "provider_provenance",
    "executable_up_down_book_coverage",
    "trade_tape_full_round_coverage",
    "decision_time_reference_coverage"
  ],
  "forbidden_collection_control_inputs": [
    "model_score",
    "accepted_bet_count",
    "settlement_outcome",
    "realized_pnl",
    "oracle_action",
    "future_return"
  ],
  "forbidden_nonempty_raw_fields": [
    "winning_outcome",
    "resolved_outcome",
    "final_outcome",
    "settlement_outcome",
    "market_resolved",
    "winning_token_id",
    "accepted_bet_net_pnl",
    "evaluation_target_net_pnl_per_contract_by_action",
    "evaluation_target_net_return_after_cost_by_action",
    "gross_pnl",
    "net_pnl",
    "settlement_pnl",
    "settlement_return",
    "realized_pnl",
    "oracle_action",
    "target_net_return_after_cost",
    "total_net_pnl_per_notional",
    "future_return",
    "future_price",
    "label"
  ],
  "append_only_index": {
    "hash_chain_required": true,
    "sequence_starts_at": 1,
    "deduplicate_identity_fields": [
      "scheduled_round_start_ts",
      "market_id",
      "slug",
      "run_id",
      "decision_id",
      "source_row_hash"
    ],
    "failed_captures_retained_with_reason_codes": true,
    "existing_rows_rewritten_allowed": false
  },
  "window_freeze": {
    "selection_method": "earliest_quality_valid_strictly_later_disjoint_rows",
    "minimum_collection_decision_ts_required": true,
    "market_id_disjointness_required": true,
    "slug_disjointness_required": true,
    "source_row_hash_disjointness_required": true,
    "index_hash_pin_required": true,
    "target_and_maximum_scan_count_frozen_before_selection": true,
    "labels_outcomes_or_pnl_opened_for_selection": false
  },
  "github_comment_policy": "bounded_batch_summary_only",
  "direct_training_corpus_root": "/Volumes/PHILIPS/v8",
  "raw_collection_exported_to_direct_training_corpus": false,
  "paper_only": true,
  "capital_at_risk": false,
  "polymarket_write_enabled": false,
  "wallet_signing_enabled": false,
  "source_model_candidate_eligible": false,
  "freeze_ready": false,
  "promotion_evidence_eligible": false,
  "v8_execution_handoff_allowed": false,
  "#134_resume_allowed": false,
  "#146_start_allowed": false
}
